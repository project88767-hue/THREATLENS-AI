PORT=8088
ENVIRONMENT=development
INTERNAL_ENGINE_KEY=threatlens-internal-dev-key-change-in-prod
HTTP_TIMEOUT_SECONDS=8.0
ENABLE_LIVE_PUBLIC_LOOKUPS=true

# Optional Threat Intelligence Provider Keys (Never exposed to frontend)
# Leave blank to automatically use clearly labelled Demo/Heuristic fallback adapters
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_API_KEY=
NVD_API_KEY=

# Optional OpenAI-compatible LLM configuration for AI Investigation Assistant
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
